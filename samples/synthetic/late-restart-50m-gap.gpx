<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="goodtohike synthetic fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <desc>One walk split into two tracks, where the walker carried on for about 50 m before remembering to press start again. The second track resumes further along the same line rather than beside it, so the join is real unrecorded trail rather than GPS drift. Under MAX_TRACK_JOIN_M of 100 m this is accepted, and the 50 m hop is under NORMAL_HOP_M so no points are inserted.</desc>
  </metadata>
  <trk>
    <name>Before The Stop</name>
    <trkseg>
      <trkpt lat="45.000000" lon="-121.000000"><ele>1000</ele></trkpt>
      <trkpt lat="45.000600" lon="-121.000000"><ele>1008</ele></trkpt>
      <trkpt lat="45.001200" lon="-121.000000"><ele>1016</ele></trkpt>
      <trkpt lat="45.001800" lon="-121.000000"><ele>1024</ele></trkpt>
      <trkpt lat="45.002400" lon="-121.000000"><ele>1032</ele></trkpt>
      <trkpt lat="45.003000" lon="-121.000000"><ele>1040</ele></trkpt>
      <trkpt lat="45.003600" lon="-121.000000"><ele>1048</ele></trkpt>
      <trkpt lat="45.004200" lon="-121.000000"><ele>1056</ele></trkpt>
      <trkpt lat="45.004800" lon="-121.000000"><ele>1064</ele></trkpt>
      <trkpt lat="45.005400" lon="-121.000000"><ele>1072</ele></trkpt>
      <trkpt lat="45.006000" lon="-121.000000"><ele>1080</ele></trkpt>
      <trkpt lat="45.006600" lon="-121.000000"><ele>1088</ele></trkpt>
    </trkseg>
  </trk>
  <trk>
    <name>After The Stop</name>
    <desc>Resumes about 50 m further on. The walker forgot to press start.</desc>
    <trkseg>
      <trkpt lat="45.007049" lon="-121.000000"><ele>1092</ele></trkpt>
      <trkpt lat="45.007649" lon="-121.000000"><ele>1100</ele></trkpt>
      <trkpt lat="45.008249" lon="-121.000000"><ele>1108</ele></trkpt>
      <trkpt lat="45.008849" lon="-121.000000"><ele>1116</ele></trkpt>
      <trkpt lat="45.009449" lon="-121.000000"><ele>1124</ele></trkpt>
      <trkpt lat="45.010049" lon="-121.000000"><ele>1132</ele></trkpt>
      <trkpt lat="45.010649" lon="-121.000000"><ele>1140</ele></trkpt>
      <trkpt lat="45.011249" lon="-121.000000"><ele>1148</ele></trkpt>
