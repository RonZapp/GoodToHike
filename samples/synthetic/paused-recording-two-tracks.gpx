<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="goodtohike synthetic fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <desc>One walk that a device split into two tracks when the user pressed pause. The second track begins about 20 m from where the first ended, which is GPS drift while standing still. Accepted and concatenated: this is the case that the track-join check exists to let through.</desc>
  </metadata>
  <trk>
    <name>Morning</name>
    <desc>Before the lunch stop.</desc>
